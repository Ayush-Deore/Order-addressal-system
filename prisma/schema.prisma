generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum OrderStatus {
  NEW
  QUOTED
  APPROVED
  IN_PRODUCTION
  DELIVERED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  designCode  String   @unique
  category    String
  material    String[] // Stored as array of strings
  finish      String[] // Stored as array of strings
  images      String[]
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  orderItems  OrderItem[]
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique // e.g. ORD-2024-001
  clientName           String
  email                String
  phone                String
  installationLocation String
  status               OrderStatus @default(NEW)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  
  quotedAmount         Float?
  quoteDetails         Json?

  items                OrderItem[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id])
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  
  height           Float
  width            Float
  thickness        Float
  quantity         Int
  openingDirection String  // Left/Right
  frameRequired    Boolean
  finishPreference String  // "Match Catalog" or Custom note
  notes            String?
}
